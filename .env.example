# Primary Cloud LLM Provider
GEMINI_API_KEY=your_gemini_api_key_here

# Local Fallback LLM Provider (T2 Twist)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Database Connection
CONNECTION_STRINGS__DEFAULTCONNECTION=Server=localhost,1433;Database=DomainCopilotDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;

# JWT Authentication
JWT__SECRET=YourSuperSecretKeyWithAtLeast32CharactersLong!
JWT__ISSUER=DomainCopilotApi
JWT__AUDIENCE=DomainCopilotClients
